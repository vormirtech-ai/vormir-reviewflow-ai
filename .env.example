# ---------------------------------------------------------------------------
# FRONTEND (Vite). Everything prefixed VITE_ is PUBLIC and shipped to browsers.
# Copy to .env.local for local development, and set the same names as build
# variables in Cloudflare Pages / GitHub Actions. Leave both Supabase values
# empty to run the browser-only demo mode.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Production origin encoded into QR codes, e.g. https://your-project.pages.dev (no trailing slash).
VITE_PUBLIC_SITE_URL=
# Optional address shown on the /contact page.
VITE_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# SERVER ONLY: Supabase Edge Function secrets. NEVER prefix these with VITE_
# and never put them in Cloudflare Pages variables. Copy this block into
# supabase/.env (git-ignored) and run:
#   supabase secrets set --env-file supabase/.env
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
FREE_MODE=true
ALLOW_PAID_AI=false
# Same origin as VITE_PUBLIC_SITE_URL. PUBLIC_SITE_URL is used by create-qr-asset, ALLOWED_ORIGIN restricts CORS.
PUBLIC_SITE_URL=
ALLOWED_ORIGIN=
# Any long random string. Salts the IP hash used for abuse limits.
IP_HASH_SALT=

# Optional overrides (defaults shown; see supabase/functions/_shared/config.ts)
# AI_ENABLED=true
# MAX_AI_REQUESTS_PER_SESSION=3
# MAX_REGENERATIONS_PER_SESSION=2
# MAX_AI_REQUESTS_PER_FUNNEL_WINDOW=30
# MAX_AI_REQUESTS_PER_IP_WINDOW=6
# AI_WINDOW_SECONDS=3600
# AI_QUOTA_COOLDOWN_SECONDS=600
# MAX_NOTE_CHARS=500
# MAX_ATTRIBUTES=8
# MAX_DRAFT_CHARS=600
# MAX_OUTPUT_TOKENS=1200
# AI_TIMEOUT_MS=15000
